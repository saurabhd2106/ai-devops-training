{
  "name": "sonarqube-node-demo",
  "version": "1.0.0",
  "description": "Express demo intentionally seeded with SonarQube training issues.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "js-test-results.xml"
  }
}
