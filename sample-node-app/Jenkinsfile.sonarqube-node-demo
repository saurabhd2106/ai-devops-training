// Declarative CI for sonarqube-node-demo (Docker build + ECR publish).
// Jenkins job Script Path: sample-node-app/Jenkinsfile.sonarqube-node-demo
// (or Jenkinsfile.sonarqube-node-demo if the job roots at sample-node-app)

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region for ECR'
        )
        string(
            name: 'ECR_REPOSITORY',
            defaultValue: 'deploy-ecr/sonarqube-node-demo',
            description: 'ECR repository name (e.g. deploy-ecr/sonarqube-node-demo)'
        )
    }

    environment {
        NODE_IMAGE = 'node:20'
        SONAR_SCANNER_IMAGE = 'sonarsource/sonar-scanner-cli:11'
        IMAGE_NAME = 'sonarqube-node-demo'
        SONAR_TOKEN = credentials('sonarqube-token')
        SONAR_PROJECT_KEY = 'sonarqube-node-demo'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (fileExists('package.json') && !fileExists('sample-node-app/package.json')) {
                        env.APP_DIR = '.'
                    } else if (fileExists('sample-node-app/package.json')) {
                        env.APP_DIR = 'sample-node-app'
                    } else if (fileExists('package.json')) {
                        env.APP_DIR = '.'
                    } else {
                        error 'Could not find package.json (expected sample-node-app or job rooted at that folder)'
                    }
                                        echo "Using application directory: ${env.APP_DIR}"
                    if (fileExists('ci/ai/ai-review.sh')) {
                        env.AI_SCRIPT = 'ci/ai/ai-review.sh'
                    } else if (fileExists("${env.APP_DIR}/ci/ai/ai-review.sh")) {
                        env.AI_SCRIPT = "${env.APP_DIR}/ci/ai/ai-review.sh"
                    } else {
                        env.AI_SCRIPT = ''
                    }
                    echo "AI script: ${env.AI_SCRIPT ?: '(not found)'}"
                }
                sh '''
                    command -v docker >/dev/null || { echo "docker not found on PATH"; exit 1; }
                    command -v aws >/dev/null || { echo "aws CLI not found on PATH"; exit 1; }
                    docker --version
                    aws --version
                '''
            }
        }

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker run --rm \
                          -v "$PWD":/workspace \
                          -w /workspace \
                          "$NODE_IMAGE" \
                          npm ci
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    dir("${APP_DIR}") {
                        sh '''
                            docker run --rm \
                              -v "$PWD":/workspace \
                              -w /workspace \
                              -e CI=true \
                              "$NODE_IMAGE" \
                              npm run test:ci
                        '''
                    }
                }
            }
            post {
                always {
                    dir("${APP_DIR}") {
                        junit allowEmptyResults: true, testResults: 'reports/junit/*.xml'
                        archiveArtifacts artifacts: 'reports/junit/**', allowEmptyArchive: true
                        archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                    }
                }
            }
        }

        
        stage('AI Test Review') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Test Review'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" tests'
                        }
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir("${APP_DIR}") {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        script {
                            if (!env.SONAR_HOST_URL?.trim()) {
                                error 'SONAR_HOST_URL must be set as a Jenkins environment variable'
                            }
                        }
                        // Cap scanner heap — default JS analyzer (~2 GiB) OOMs the lab Jenkins VM.
                        sh '''
                            docker run --rm \
                              --network host \
                              -v "$PWD":/usr/src \
                              -e SONAR_HOST_URL \
                              -e SONAR_TOKEN \
                              -e SONAR_SCANNER_JAVA_OPTS=-Xmx512m \
                              -w /usr/src \
                              "$SONAR_SCANNER_IMAGE" \
                              -Dsonar.host.url="${SONAR_HOST_URL}" \
                              -Dsonar.token="${SONAR_TOKEN}" \
                              -Dsonar.javascript.node.maxspace=512
                        '''
                    }
                }
            }
        }

        
        stage('AI Quality Review') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Quality Review'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" sonar'
                        }
                    }
                }
            }
        }

        stage('AI Change Risk') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Change Risk'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" change'
                        }
                    }
                }
            }
        }

        stage('Publish') {
            steps {
                dir("${APP_DIR}") {
                    script {
                        def region = params.AWS_REGION.trim()
                        def repo = params.ECR_REPOSITORY.trim()
                        def accountId = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        def registry = "${accountId}.dkr.ecr.${region}.amazonaws.com"
                        def imageTag = "${registry}/${repo}:${env.BUILD_NUMBER}"
                        def imageLatest = "${registry}/${repo}:latest"

                        sh """
                            docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} -t ${IMAGE_NAME}:latest .
                            docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${imageTag}
                            docker tag ${IMAGE_NAME}:latest ${imageLatest}
                            aws ecr get-login-password --region ${region} | \
                              docker login --username AWS --password-stdin ${registry}
                            docker push ${imageTag}
                            docker push ${imageLatest}
                        """

                        echo "Published ${imageTag} and ${imageLatest}"
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'ai-review/**', allowEmptyArchive: true
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
