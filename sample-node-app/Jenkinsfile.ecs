// Declarative CI/CD for sonarqube-node-demo: build, test, Sonar, ECR, ECS.
// Jenkins job Script Path: sample-node-app/Jenkinsfile.ecs
// (or Jenkinsfile.ecs if the job roots at sample-node-app)
//
// Prerequisites:
//   - SONAR_HOST_URL Jenkins env var; credential ID sonarqube-token
//   - Docker, aws CLI, python3 on the agent
//   - deploy-vm instance role: ecr_push_pull_policy_arn + ecs_deploy_policy_arn
//   - ECS service configured for container_port 3000 and health_check_path /health

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region for ECR and ECS'
        )
        string(
            name: 'ECR_REPOSITORY',
            defaultValue: 'deploy-ecr/sonarqube-node-demo',
            description: 'ECR repository name (e.g. deploy-ecr/sonarqube-node-demo)'
        )
        string(
            name: 'ECS_CLUSTER',
            defaultValue: 'deploy-ecs-development-cluster',
            description: 'ECS cluster name (terraform -chdir=deploy-ecs output -raw ecs_cluster_name)'
        )
        string(
            name: 'ECS_SERVICE',
            defaultValue: 'app',
            description: 'ECS service name'
        )
        string(
            name: 'ECS_TASK_FAMILY',
            defaultValue: 'deploy-ecs-development-app',
            description: 'ECS task definition family'
        )
        string(
            name: 'ECS_CONTAINER_NAME',
            defaultValue: 'app',
            description: 'Container name in the task definition to update'
        )
        string(
            name: 'ECS_CONTAINER_PORT',
            defaultValue: '3000',
            description: 'Container port for Express (must match ALB target group)'
        )
    }

    environment {
        NODE_IMAGE = 'node:20'
        SONAR_SCANNER_IMAGE = 'sonarsource/sonar-scanner-cli:11'
        IMAGE_NAME = 'sonarqube-node-demo'
        SONAR_TOKEN = credentials('sonarqube-token')
        SONAR_PROJECT_KEY = 'sonarqube-node-demo'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (fileExists('package.json') && !fileExists('sample-node-app/package.json')) {
                        env.APP_DIR = '.'
                    } else if (fileExists('sample-node-app/package.json')) {
                        env.APP_DIR = 'sample-node-app'
                    } else if (fileExists('package.json')) {
                        env.APP_DIR = '.'
                    } else {
                        error 'Could not find package.json (expected sample-node-app or job rooted at that folder)'
                    }
                                        echo "Using application directory: ${env.APP_DIR}"
                    if (fileExists('ci/ai/ai-review.sh')) {
                        env.AI_SCRIPT = 'ci/ai/ai-review.sh'
                    } else if (fileExists("${env.APP_DIR}/ci/ai/ai-review.sh")) {
                        env.AI_SCRIPT = "${env.APP_DIR}/ci/ai/ai-review.sh"
                    } else {
                        env.AI_SCRIPT = ''
                    }
                    echo "AI script: ${env.AI_SCRIPT ?: '(not found)'}"
                }
                sh '''
                    command -v docker >/dev/null || { echo "docker not found on PATH"; exit 1; }
                    command -v aws >/dev/null || { echo "aws CLI not found on PATH"; exit 1; }
                    command -v python3 >/dev/null || { echo "python3 not found on PATH"; exit 1; }
                    docker --version
                    aws --version
                    python3 --version
                '''
            }
        }

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker run --rm \
                          -v "$PWD":/workspace \
                          -w /workspace \
                          "$NODE_IMAGE" \
                          npm ci
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    dir("${APP_DIR}") {
                        sh '''
                            docker run --rm \
                              -v "$PWD":/workspace \
                              -w /workspace \
                              -e CI=true \
                              "$NODE_IMAGE" \
                              npm run test:ci
                        '''
                    }
                }
            }
            post {
                always {
                    dir("${APP_DIR}") {
                        junit allowEmptyResults: true, testResults: 'reports/junit/*.xml'
                        archiveArtifacts artifacts: 'reports/junit/**', allowEmptyArchive: true
                        archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                    }
                }
            }
        }

        
        stage('AI Test Review') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Test Review'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" tests'
                        }
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir("${APP_DIR}") {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        script {
                            if (!env.SONAR_HOST_URL?.trim()) {
                                error 'SONAR_HOST_URL must be set as a Jenkins environment variable'
                            }
                        }
                        // Cap scanner heap — default JS analyzer (~2 GiB) OOMs the lab Jenkins VM.
                        sh '''
                            docker run --rm \
                              --network host \
                              -v "$PWD":/usr/src \
                              -e SONAR_HOST_URL \
                              -e SONAR_TOKEN \
                              -e SONAR_SCANNER_JAVA_OPTS=-Xmx512m \
                              -w /usr/src \
                              "$SONAR_SCANNER_IMAGE" \
                              -Dsonar.host.url="${SONAR_HOST_URL}" \
                              -Dsonar.token="${SONAR_TOKEN}" \
                              -Dsonar.javascript.node.maxspace=512
                        '''
                    }
                }
            }
        }

        
        stage('AI Quality Review') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Quality Review'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" sonar'
                        }
                    }
                }
            }
        }

        stage('AI Change Risk') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Change Risk'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" change'
                        }
                    }
                }
            }
        }

        stage('Publish ECR') {
            steps {
                dir("${APP_DIR}") {
                    script {
                        def region = params.AWS_REGION.trim()
                        def repo = params.ECR_REPOSITORY.trim()
                        def accountId = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        def registry = "${accountId}.dkr.ecr.${region}.amazonaws.com"
                        def imageTag = "${registry}/${repo}:${env.BUILD_NUMBER}"
                        def imageLatest = "${registry}/${repo}:latest"

                        env.DEPLOY_IMAGE = imageTag
                        env.DEPLOY_IMAGE_LATEST = imageLatest

                        sh """
                            docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} -t ${IMAGE_NAME}:latest .
                            docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${imageTag}
                            docker tag ${IMAGE_NAME}:latest ${imageLatest}
                            aws ecr get-login-password --region ${region} | \
                              docker login --username AWS --password-stdin ${registry}
                            docker push ${imageTag}
                            docker push ${imageLatest}
                        """

                        echo "Published ${imageTag} and ${imageLatest}"
                    }
                }
            }
        }

        stage('Deploy ECS') {
            steps {
                script {
                    def region = params.AWS_REGION.trim()
                    def cluster = params.ECS_CLUSTER.trim()
                    def service = params.ECS_SERVICE.trim()
                    def family = params.ECS_TASK_FAMILY.trim()
                    def containerName = params.ECS_CONTAINER_NAME.trim()
                    def containerPort = (params.ECS_CONTAINER_PORT ?: '3000').trim()
                    def image = env.DEPLOY_IMAGE

                    if (!image?.trim()) {
                        error 'DEPLOY_IMAGE was not set by Publish ECR stage'
                    }

                    withEnv([
                        "AWS_DEFAULT_REGION=${region}",
                        "ECS_CLUSTER=${cluster}",
                        "ECS_SERVICE=${service}",
                        "ECS_TASK_FAMILY=${family}",
                        "ECS_CONTAINER_NAME=${containerName}",
                        "ECS_CONTAINER_PORT=${containerPort}",
                        "DEPLOY_IMAGE=${image}",
                        "ECS_STABLE_TIMEOUT_SEC=600",
                        "ECS_STABLE_POLL_SEC=20",
                    ]) {
                        sh '''
                            set -euo pipefail
                            mkdir -p "${WORKSPACE}/ai-review"

                            aws sts get-caller-identity
                            aws ecs describe-clusters --clusters "${ECS_CLUSTER}" \
                              --query 'clusters[0].status' --output text | grep -qx ACTIVE

                            CURRENT_TD=$(aws ecs describe-task-definition \
                              --task-definition "${ECS_TASK_FAMILY}" \
                              --query 'taskDefinition' --output json)

                            NEW_TD=$(python3 -c '
import json, os, sys

td = json.loads(sys.stdin.read())
container = os.environ["ECS_CONTAINER_NAME"]
image = os.environ["DEPLOY_IMAGE"]
container_port = int(os.environ.get("ECS_CONTAINER_PORT", "3000"))

found = False
for c in td.get("containerDefinitions", []):
    if c.get("name") == container:
        c["image"] = image
        c["portMappings"] = [{
            "containerPort": container_port,
            "hostPort": container_port,
            "protocol": "tcp",
        }]
        found = True
        break
if not found:
    raise SystemExit(f"container {container!r} not found in task definition")

for key in (
    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy",
    "deregisteredAt",
):
    td.pop(key, None)

print(json.dumps(td))
' <<< "${CURRENT_TD}")

                            echo "${NEW_TD}" > /tmp/ecs-task-def.json

                            NEW_REVISION=$(aws ecs register-task-definition \
                              --cli-input-json file:///tmp/ecs-task-def.json \
                              --query 'taskDefinition.revision' --output text)

                            echo "Registered ${ECS_TASK_FAMILY}:${NEW_REVISION} with image ${DEPLOY_IMAGE}"

                            aws ecs update-service \
                              --cluster "${ECS_CLUSTER}" \
                              --service "${ECS_SERVICE}" \
                              --task-definition "${ECS_TASK_FAMILY}:${NEW_REVISION}" \
                              --force-new-deployment

                            echo "Waiting for PRIMARY deployment to become COMPLETED (timeout ${ECS_STABLE_TIMEOUT_SEC}s)..."
                            DEADLINE=$(( $(date +%s) + ECS_STABLE_TIMEOUT_SEC ))
                            while true; do
                              NOW=$(date +%s)
                              if [ "${NOW}" -ge "${DEADLINE}" ]; then
                                echo "Timed out waiting for ECS service to stabilize. Current deployments:"
                                mkdir -p "${WORKSPACE}/ai-review"
                                {
                                  echo "{\"target\":\"ecs\",\"cluster\":\"${ECS_CLUSTER}\",\"service\":\"${ECS_SERVICE}\",\"error\":\"stabilize timeout\"}"
                                  echo "--- deployments ---"
                                  aws ecs describe-services \
                                    --cluster "${ECS_CLUSTER}" \
                                    --services "${ECS_SERVICE}" \
                                    --query 'services[0].deployments' --output json || true
                                  echo "--- stopped tasks ---"
                                  STOPPED=$(aws ecs list-tasks \
                                    --cluster "${ECS_CLUSTER}" \
                                    --service-name "${ECS_SERVICE}" \
                                    --desired-status STOPPED \
                                    --query 'taskArns[0:3]' --output text)
                                  if [ -n "${STOPPED}" ] && [ "${STOPPED}" != "None" ]; then
                                    aws ecs describe-tasks \
                                      --cluster "${ECS_CLUSTER}" \
                                      --tasks ${STOPPED} \
                                      --query 'tasks[*].{stoppedReason:stoppedReason,stopCode:stopCode,taskDef:taskDefinitionArn}' \
                                      --output json || true
                                  fi
                                } | tee "${WORKSPACE}/ai-review/deploy-diagnostics.json"
                                exit 1
                              fi

                              ROLL=$(aws ecs describe-services \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].deployments[?status==`PRIMARY`] | [0].{rollout:rolloutState,running:runningCount,desired:desiredCount,failed:failedTasks,taskDef:taskDefinition}' \
                                --output json)
                              echo "$(date -u +%H:%M:%S) PRIMARY=${ROLL}"

                              echo "${ROLL}" | python3 -c '
import json, sys
d = json.load(sys.stdin)
ok = (
    d.get("rollout") == "COMPLETED"
    and int(d.get("running") or 0) == int(d.get("desired") or -1)
    and int(d.get("desired") or 0) > 0
)
sys.exit(0 if ok else 1)
' && break

                              sleep "${ECS_STABLE_POLL_SEC}"
                            done

                            echo "Deployed ${ECS_SERVICE} on ${ECS_CLUSTER} using ${ECS_TASK_FAMILY}:${NEW_REVISION}"
                        '''
                    }
                }
            }
        }
    }

    post {
        failure {
            catchError(buildResult: 'FAILURE', stageResult: 'UNSTABLE') {
                script {
                    if (!env.AI_SCRIPT?.trim()) {
                        echo 'AI script not found; skipping AI Deploy RCA'
                        return
                    }
                    def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                    withEnv([
                        "APP_DIR=${env.APP_DIR}",
                        "AWS_DEFAULT_REGION=${region}",
                        "AI_DEPLOY_DIAG=${env.WORKSPACE}/ai-review/deploy-diagnostics.json",
                    ]) {
                        sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" deploy || true'
                    }
                }
            }
        }

        always {
            archiveArtifacts artifacts: 'ai-review/**', allowEmptyArchive: true
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
