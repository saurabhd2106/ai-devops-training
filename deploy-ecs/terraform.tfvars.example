# Copy to terraform.tfvars and fill in required values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Do not commit terraform.tfvars (it is gitignored).
#
# This example matches the sample-java-app / Jenkinsfile.ecs lab path.
# For sample-node-app, swap the app service block for the Node example below.
# Module defaults in variables.tf still use nginx so a bare apply without
# an ECR image URL can serve a public demo.

aws_region   = "us-east-1"
project_name = "deploy-ecs"
environment  = "development"

# Java Spring Boot (sonarqube-java-demo) — use with sample-java-app/Jenkinsfile.ecs.
# Replace ACCOUNT with your AWS account ID (or terraform -chdir=../deploy-ecr output).
services = {
  app = {
    image             = "ACCOUNT.dkr.ecr.us-east-1.amazonaws.com/deploy-ecr/sonarqube-java-demo:latest"
    cpu               = 512
    memory            = 1024
    container_port    = 8080
    desired_count     = 1
    path_pattern      = "/*"
    listener_priority = 100
    create_ecr        = false
    health_check_path = "/health"
    # enabled         = true
  }
  # Node Express (sonarqube-node-demo) — use with sample-node-app/Jenkinsfile.ecs
  # (replace the Java app block above; only one app service on /* at a time):
  # app = {
  #   image             = "ACCOUNT.dkr.ecr.us-east-1.amazonaws.com/deploy-ecr/sonarqube-node-demo:latest"
  #   cpu               = 256
  #   memory            = 512
  #   container_port    = 3000
  #   desired_count     = 1
  #   path_pattern      = "/*"
  #   listener_priority = 100
  #   create_ecr        = false
  #   health_check_path = "/health"
  # }
  # Optional nginx quick-start (no custom image required):
  # app = {
  #   image             = "public.ecr.aws/docker/library/nginx:stable"
  #   cpu               = 512
  #   memory            = 1024
  #   container_port    = 80
  #   desired_count     = 1
  #   path_pattern      = "/*"
  #   listener_priority = 100
  #   create_ecr        = true
  #   health_check_path = "/"
  # }
  # Example second service (path-based routing on the same ALB):
  # api = {
  #   image             = "public.ecr.aws/docker/library/httpd:2.4"
  #   cpu               = 256
  #   memory            = 512
  #   container_port    = 80
  #   desired_count     = 1
  #   path_pattern      = "/api*"
  #   listener_priority = 50
  #   create_ecr        = true
  #   health_check_path = "/"
  # }
}

# ALB HTTP/HTTPS ingress. Open demo uses 0.0.0.0/0; prefer your public IP as /32 for locked-down labs.
allowed_ingress_cidr = "0.0.0.0/0"

# Optional: ACM certificate ARN in this region enables HTTPS :443 + HTTP→HTTPS redirect
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Optional
# enable_container_insights = false
# vpc_cidr                  = "10.0.0.0/16"
# public_subnet_cidrs       = ["10.0.1.0/24", "10.0.2.0/24"]
# private_subnet_cidrs      = ["10.0.11.0/24", "10.0.12.0/24"]
