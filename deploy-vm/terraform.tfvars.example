# Copy to terraform.tfvars and fill in required values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Do not commit terraform.tfvars (it is gitignored).

aws_region   = "us-east-1"
project_name = "deploy-vm"
environment  = "development"

# Map of VMs: change instance_type / root_volume_size / ingress_ports per role.
# Set enabled = false to skip creating a role without removing it from the map.
vms = {
  app = {
    instance_type    = "t3.small"
    root_volume_size = 30
    ingress_ports    = [80, 443]
    # enabled        = true
  }
  sonarqube = {
    instance_type    = "t3.medium"
    root_volume_size = 50
    ingress_ports    = [9000]
  }
  jenkins = {
    instance_type    = "t3.medium"
    root_volume_size = 40
    ingress_ports    = [8080]
  }
}

# REQUIRED: your public IP as /32 (find with: curl -s ifconfig.me)
# Used for SSH (22) and each role's ingress_ports.
allowed_ssh_cidr = "203.0.113.25/32"

# REQUIRED: paste your OpenSSH public key (never the private key)
ssh_public_key = "ssh-ed25519 AAAA... your-comment"

# Optional
# key_name                   = "deploy-vm-key"
# enable_detailed_monitoring = false
#
# After apply in ../deploy-ecr, attach ECR push/pull so Jenkins can publish images:
#   terraform -chdir=../deploy-ecr output -raw push_pull_policy_arn
# ecr_push_pull_policy_arn = "arn:aws:iam::ACCOUNT:policy/deploy-ecr-ecr-push-pull-development"
#
# After apply in ../deploy-ecs, attach CI deploy so Jenkins can update ECS services:
#   terraform -chdir=../deploy-ecs output -raw ci_deploy_policy_arn
# ecs_deploy_policy_arn = "arn:aws:iam::ACCOUNT:policy/deploy-ecs-development-ci-deploy"
#
# After apply in ../deploy-eks (with ci_principal_arn), attach CI deploy for kubectl:
#   terraform -chdir=../deploy-eks output -raw ci_deploy_policy_arn
# eks_deploy_policy_arn = "arn:aws:iam::ACCOUNT:policy/deploy-eks-development-ci-deploy"
