# Copy to terraform.tfvars and fill in required values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Do not commit terraform.tfvars (it is gitignored).

aws_region   = "us-east-1"
project_name = "deploy-eks"
environment  = "development"

# Kubernetes version for control plane and node group
cluster_version = "1.34"

# Optional: EKS public API CIDR (default 0.0.0.0/0 for demo labs).
# Narrow to YOUR_IP/32 if you want to lock the lab down.
allowed_api_cidr = "0.0.0.0/0"

# Optional: extra API CIDRs only needed if you override allowed_api_cidr to a narrow range
#   terraform -chdir=../deploy-vm output -json public_ips
# additional_api_cidrs = ["203.0.113.50/32"]

# Optional: grant Jenkins instance role cluster admin via EKS access entry (Terraform AuthZ)
#   terraform -chdir=../deploy-vm output -raw instance_role_arn
# ci_principal_arn = "arn:aws:iam::ACCOUNT:role/deploy-vm-development-XXXX"

# Optional node group sizing
# node_instance_types = ["t3.medium"]
# node_desired_size   = 2
# node_min_size       = 1
# node_max_size       = 3
# node_disk_size      = 20

# Optional networking (defaults leave room next to deploy-vm 10.0.0.0/16)
# vpc_cidr             = "10.20.0.0/16"
# public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
# private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

# Optional: enable control-plane CloudWatch logs (extra cost)
# enable_cluster_logs = false
