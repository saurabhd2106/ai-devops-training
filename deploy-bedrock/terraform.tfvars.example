# Copy to terraform.tfvars and adjust as needed:
#   cp terraform.tfvars.example terraform.tfvars
#
# Do not commit terraform.tfvars (it is gitignored).

aws_region   = "us-east-1"
project_name = "deploy-bedrock"
environment  = "development"

# Lab default: Amazon Nova Lite only (no Claude / Anthropic agreements).
# Third-party models are out of scope for this lab; enable via models{} + agreements if needed.
models = {
  nova_lite = {
    model_id          = "amazon.nova-lite-v1:0"
    inference_profile = "us.amazon.nova-lite-v1:0"
    accept_agreement  = false
  }
}

# Regional singleton — only one Bedrock logging config exists per region.
enable_invocation_logging = true
log_retention_days        = 14

# Optional Guardrail (content + profanity filters)
enable_guardrail = false
# guardrail_name   = "deploy-bedrock-guardrail"

# Anthropic first-time use-case form (not needed for Nova Lite)
enable_anthropic_use_case = false
