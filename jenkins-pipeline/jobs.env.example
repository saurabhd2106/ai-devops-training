# Copy to jobs.env and fill in. Do not commit jobs.env.
#   cp jobs.env.example jobs.env

JENKINS_URL=http://<jenkins-public-ip>:8080
JENKINS_USER=admin
JENKINS_TOKEN=<api-token>

# Git SCM for Pipeline script from SCM (monorepo root)
REPO_URL=https://github.com/saurabhd2106/ai-devops-training.git
BRANCH=*/main

# Optional: Jenkins credentials ID for private Git repos (leave empty for public)
# GIT_CREDENTIALS_ID=
