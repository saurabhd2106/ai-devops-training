pipeline {
    agent any

    parameters {
        string(
            name: 'SONAR_HOST_URL',
            defaultValue: 'http://localhost:9000',
            description: 'SonarQube base URL (use the SonarQube private IP from terraform output private_ips, e.g. http://10.0.1.x:9000)'
        )
        string(
            name: 'S3_BUCKET',
            defaultValue: '',
            description: 'CI artifacts S3 bucket name from terraform output ci_artifacts_bucket'
        )
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-26-amazon-corretto.x86_64'
        PATH = "/opt/maven/bin:/opt/sonar-scanner/bin:${env.JAVA_HOME}/bin:${env.PATH}"
        SONAR_TOKEN = credentials('sonarqube-token')
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (fileExists('sample-java-app/pom.xml')) {
                        env.APP_DIR = 'sample-java-app'
                    } else if (fileExists('pom.xml')) {
                        env.APP_DIR = '.'
                    } else {
                        error('Neither sample-java-app/pom.xml nor pom.xml found in workspace')
                    }
                    echo "Using application directory: ${env.APP_DIR}"
                }
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B -DskipTests compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    dir(env.APP_DIR) {
                        junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube Scan') {
            steps {
                dir(env.APP_DIR) {
                    withEnv(["SONAR_HOST_URL=${params.SONAR_HOST_URL}"]) {
                        sh '''
                            mvn -B -DskipTests package
                            sonar-scanner \
                              -Dsonar.host.url="${SONAR_HOST_URL}" \
                              -Dsonar.token="${SONAR_TOKEN}"
                        '''
                    }
                }
            }
        }

        stage('Publish artefacts') {
            steps {
                dir(env.APP_DIR) {
                    archiveArtifacts artifacts: 'target/sonarqube-java-demo-*.jar,target/surefire-reports/*.xml', fingerprint: true, allowEmptyArchive: false
                    script {
                        if (!params.S3_BUCKET?.trim()) {
                            error('S3_BUCKET parameter is required (terraform output ci_artifacts_bucket)')
                        }
                        sh """
                            aws s3 cp target/sonarqube-java-demo-0.0.1-SNAPSHOT.jar \
                              "s3://${params.S3_BUCKET}/sample-java-app/${env.BUILD_NUMBER}/" \
                              --only-show-errors
                            if [ -d target/surefire-reports ]; then
                              aws s3 cp target/surefire-reports/ \
                                "s3://${params.S3_BUCKET}/sample-java-app/${env.BUILD_NUMBER}/surefire-reports/" \
                                --recursive --only-show-errors
                            fi
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
