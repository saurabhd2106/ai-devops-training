pipeline {
    agent any

    parameters {
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region for S3 uploads (override; defaults to us-east-1)'
        )
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-26-amazon-corretto.x86_64'
        PATH = "/opt/maven/bin:/opt/sonar-scanner/bin:${env.JAVA_HOME}/bin:${env.PATH}"
        SONAR_TOKEN = credentials('sonarqube-token')
        JAR_NAME = 'sonarqube-java-demo-0.0.1-SNAPSHOT.jar'
        SONAR_PROJECT_KEY = 'sonarqube-java-demo'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (fileExists('sample-java-app/pom.xml')) {
                        env.APP_DIR = 'sample-java-app'
                    } else if (fileExists('pom.xml')) {
                        env.APP_DIR = '.'
                    } else {
                        error('Neither sample-java-app/pom.xml nor pom.xml found in workspace')
                    }
                    echo "Using application directory: ${env.APP_DIR}"
                    if (fileExists('ci/ai/ai-review.sh')) {
                        env.AI_SCRIPT = 'ci/ai/ai-review.sh'
                    } else if (fileExists("${env.APP_DIR}/ci/ai/ai-review.sh")) {
                        env.AI_SCRIPT = "${env.APP_DIR}/ci/ai/ai-review.sh"
                    } else {
                        env.AI_SCRIPT = ''
                    }
                    echo "AI script: ${env.AI_SCRIPT ?: '(not found)'}"
                }
                sh '''
                    command -v mvn >/dev/null || { echo "mvn not found on PATH (expected /opt/maven/bin from install-jenkins)"; exit 1; }
                    command -v aws >/dev/null || { echo "aws CLI not found on PATH"; exit 1; }
                    mvn -version
                    aws --version
                '''
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B -DskipTests compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    dir(env.APP_DIR) {
                        junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('AI Test Review') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Test Review'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" tests'
                        }
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B -DskipTests package'
                    sh "test -f target/${JAR_NAME}"
                }
            }
        }

        stage('SonarQube Scan') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    dir(env.APP_DIR) {
                        script {
                            if (!env.SONAR_HOST_URL?.trim()) {
                                error('SONAR_HOST_URL must be set as a Jenkins environment variable')
                            }
                        }
                        sh '''
                            sonar-scanner \
                              -Dsonar.host.url="${SONAR_HOST_URL}" \
                              -Dsonar.token="${SONAR_TOKEN}"
                        '''
                    }
                }
            }
        }

        stage('AI Quality Review') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Quality Review'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" sonar'
                        }
                    }
                }
            }
        }

        stage('AI Change Risk') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    script {
                        if (!env.AI_SCRIPT?.trim()) {
                            echo 'AI script not found; skipping AI Change Risk'
                            return
                        }
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        withEnv(["APP_DIR=${env.APP_DIR}", "AWS_DEFAULT_REGION=${region}"]) {
                            sh 'chmod +x "${AI_SCRIPT}" && "${AI_SCRIPT}" change'
                        }
                    }
                }
            }
        }

        stage('Publish artefacts') {
            steps {
                dir(env.APP_DIR) {
                    archiveArtifacts artifacts: 'target/sonarqube-java-demo-*.jar,target/surefire-reports/*.xml', fingerprint: true, allowEmptyArchive: false
                    script {
                        if (!env.S3_BUCKET?.trim()) {
                            error('S3_BUCKET must be set as a Jenkins environment variable (terraform -chdir=deploy-vm output -raw ci_artifacts_bucket)')
                        }
                        def bucket = env.S3_BUCKET.trim()
                        def region = params.AWS_REGION?.trim() ?: 'us-east-1'
                        def prefix = "sample-java-app/${env.BUILD_NUMBER}"
                        withEnv(["AWS_DEFAULT_REGION=${region}", "S3_BUCKET=${bucket}", "S3_PREFIX=${prefix}"]) {
                            sh '''
                                command -v aws >/dev/null || { echo "aws CLI not found on PATH"; exit 1; }
                                aws sts get-caller-identity
                                test -f "target/${JAR_NAME}"
                                aws s3 cp "target/${JAR_NAME}" \
                                  "s3://${S3_BUCKET}/${S3_PREFIX}/" \
                                  --only-show-errors
                                if [ -d target/surefire-reports ]; then
                                  aws s3 cp target/surefire-reports/ \
                                    "s3://${S3_BUCKET}/${S3_PREFIX}/surefire-reports/" \
                                    --recursive --only-show-errors
                                fi
                                if [ -d "${WORKSPACE}/ai-review" ]; then
                                  aws s3 cp "${WORKSPACE}/ai-review/" \
                                    "s3://${S3_BUCKET}/${S3_PREFIX}/ai-review/" \
                                    --recursive --only-show-errors
                                fi
                                aws s3 ls "s3://${S3_BUCKET}/${S3_PREFIX}/"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'ai-review/**', allowEmptyArchive: true
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
